{
  "manifest_version": 3,
  "name": "Plexo Download Manager",
  "version": "1.3.1",
  "description": "Send downloads and direct media links to the Plexo Windows app.",
  "minimum_chrome_version": "120",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "webRequest",
    "cookies",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plexo downloads",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}